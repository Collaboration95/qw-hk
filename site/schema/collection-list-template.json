{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "{{title}}",
  "url": "{{path}}",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "{{item_title}}",
        "url": "{{item_path}}"
      }
    ]
  }
}
